# Stage 1: Compile Go for Linux ARM64
FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

# Dependencies needed by packages using CGO.
RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    gcc \
    libc6-dev \
    pkg-config \
    libx11-dev \
    libxtst-dev \
    libpng-dev \
    libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build the cloud entrypoint.
# This avoids compiling the Windows desktop automation entrypoint.
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" \
    -o /out/server ./cmd/cloud


# Stage 2: Runtime with Python
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHON_EXECUTABLE=/opt/venv/bin/python \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Install Python dependencies in an isolated environment.
RUN python -m venv /opt/venv

COPY market_processor/requirements.txt \
    /app/market_processor/requirements.txt

RUN pip install --no-cache-dir \
    -r /app/market_processor/requirements.txt \
    python-dotenv

# Copy only the required runtime files.
COPY --from=builder /out/server /app/server

COPY market_processor/market_processor.py \
    /app/market_processor/market_processor.py

# Run as an unprivileged user.
RUN useradd --system --create-home appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

CMD ["/app/server"]