# Database Settings
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=autoclicker_db
MYSQL_USER=autoclicker_user
MYSQL_PASSWORD=your_secure_user_password_here

# Go Application DSN
# Format: username:password@tcp(127.0.0.1:3306)/database_name?parseTime=true
DB_DSN=autoclicker_user:your_secure_user_password_here@tcp(127.0.0.1:3306)/autoclicker_db?parseTime=true